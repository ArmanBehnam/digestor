# =============================================================================
# Digestor Unified - Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Environment ---
ENVIRONMENT=development
PROCESS_TYPE=web  # web or worker

# --- Database (RDS PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://digestor:digestor_dev_password@localhost:5432/digestor_dev

# --- Redis (ElastiCache) ---
REDIS_URL=redis://localhost:6379

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- S3 ---
S3_BUCKET=digestor-unified-uploads-dev

# --- Cognito ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- LLM API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Azure OCR (fallback) ---
AZURE_ENDPOINT=
AZURE_API_KEY=

# --- Email (SES) ---
SES_FROM_EMAIL=noreply@digestor.com
ADMIN_EMAIL=admin@digestor.com

# --- Secrets Manager (production) ---
USE_SECRETS_MANAGER=false
SECRETS_MANAGER_SECRET_NAME=digetor/production/secrets

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Logging ---
SQL_ECHO=false
LOG_LEVEL=INFO
