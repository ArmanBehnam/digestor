{
  "containerDefinitions": [
    {
      "name": "web",
      "image": "IMAGE_PLACEHOLDER",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "PROCESS_TYPE", "value": "web" },
        { "name": "PORT", "value": "8080" },
        { "name": "ENVIRONMENT", "value": "dev" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_DEFAULT_REGION", "value": "us-east-1" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "S3_BUCKET", "value": "digestor-unified-uploads-dev" },
        { "name": "S3_BUCKET_NAME", "value": "digestor-unified-uploads-dev" },
        { "name": "COGNITO_USER_POOL_ID", "value": "us-east-1_DGMrbW6Vw" },
        { "name": "COGNITO_APP_CLIENT_ID", "value": "6k00q57poml1uooj9aal7tga8c" },
        { "name": "COGNITO_CLIENT_ID", "value": "6k00q57poml1uooj9aal7tga8c" },
        { "name": "COGNITO_REGION", "value": "us-east-1" },
        { "name": "DATABASE_URL", "value": "DATABASE_URL_PLACEHOLDER" },
        { "name": "REDIS_URL", "value": "REDIS_URL_PLACEHOLDER" },
        { "name": "OPENAI_API_KEY", "value": "OPENAI_API_KEY_PLACEHOLDER" },
        { "name": "AZURE_API_KEY", "value": "AZURE_API_KEY_PLACEHOLDER" },
        { "name": "AZURE_ENDPOINT", "value": "AZURE_ENDPOINT_PLACEHOLDER" },
        { "name": "GEMINI_API_KEY", "value": "GEMINI_API_KEY_PLACEHOLDER" }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/digestor-dev",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "web"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "systemControls": []
    }
  ],
  "family": "digestor-web-dev",
  "taskRoleArn": "arn:aws:iam::800712212732:role/digestor-ecs-task-dev",
  "executionRoleArn": "arn:aws:iam::800712212732:role/digestor-ecs-execution-dev",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
